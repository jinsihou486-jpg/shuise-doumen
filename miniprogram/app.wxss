page {
  --paper: #f4f1ec;
  --water: #e8edef;
  --ink: #1f2329;
  --qing: #2c5f5d;
  --red: #c84b3a;
  --red-soft: #f2d5d0;
  --blue: #3a6b8c;
  --blue-soft: #d4e4ef;
  --pink: #d4787a;
  --pink-soft: #f5e0e0;
  --warm: #f0c060;
  --muted: #6d7470;
  --line: rgba(44, 95, 93, 0.28);
  --shadow: 0 8px 24px rgba(31, 35, 41, 0.06);
  --radius: 12px;
  background: var(--paper);
  color: var(--ink);
  font-family: "PingFang SC", "Source Han Sans SC", "Noto Sans SC", "Microsoft YaHei", sans-serif;
  font-size: 15px;
  line-height: 1.7;
}

page::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 80;
  opacity: 0.35;
  background-image: url("/images/noise.png");
  background-size: 64px 64px;
}

.reduce .motion,
.reduce .wave {
  animation: none !important;
  transition: none !important;
}

.serif {
  font-family: "Source Han Serif SC", "Noto Serif SC", "Songti SC", "STSong", "SimSun", serif;
}

.h1 {
  font-size: 24px;
  line-height: 1.45;
  font-weight: 700;
  color: var(--qing);
}

.h2 {
  font-size: 17px;
  line-height: 1.5;
  color: var(--qing);
}

.body {
  font-size: 15px;
  line-height: 1.7;
}

.meta {
  font-size: 12px;
  color: var(--muted);
  line-height: 1.5;
}

.quote {
  font-size: 22px;
  line-height: 1.5;
  letter-spacing: 0.02em;
}

.pad {
  padding-left: 16px;
  padding-right: 16px;
}

.outline {
  height: 46px;
  line-height: 46px;
  text-align: center;
  border: 1px solid var(--qing);
  border-radius: var(--radius);
  color: var(--qing);
  background: transparent;
  font-size: 15px;
}

.outline::after {
  border: none;
}

.link {
  color: var(--qing);
  font-size: 15px;
  background: transparent;
  border: 0;
  padding: 0;
  line-height: 1.6;
}

.link::after {
  border: none;
}
