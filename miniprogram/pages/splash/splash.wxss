.splash {
  min-height: 100vh;
  background: #1f2329;
  color: #f4f1ec;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.word {
  font-size: 64px;
  font-weight: 700;
  letter-spacing: 0.2em;
  z-index: 2;
}

.mist {
  position: absolute;
  left: -10%;
  right: -10%;
  bottom: 18%;
  height: 180px;
  background: #e8edef;
  opacity: 0.28;
  border-radius: 50%;
  animation: drift 8s linear infinite;
}

.hint {
  position: absolute;
  bottom: 48px;
  color: #e8edef;
  letter-spacing: 0.2em;
}

@keyframes drift {
  0% { transform: translateX(-3px); }
  50% { transform: translateX(3px); }
  100% { transform: translateX(-3px); }
}
