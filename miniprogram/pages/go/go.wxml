<view class="pad page" style="--accent: {{accent}};">
  <view class="h1 serif">{{spot.name}}</view>
  <view class="meta">{{spot.address}}</view>
  <view class="meta">{{spot.locationNote}}</view>

  <view class="timeline">
    <view class="step"><text class="h2 serif">出发</text><text class="body">从你现在的位置去这一弯，不经过已停运的灯笼沙景区。</text></view>
    <view class="step"><text class="h2 serif">在路上</text><text class="body">{{spot.driveMinutes}}。费用 {{spot.driveCost}}。</text></view>
    <view class="step"><text class="h2 serif">到了</text><text class="body">{{spot.onSite}}</text></view>
  </view>

  <view class="ways">
    <view class="card {{mode === 'bus' ? 'on' : ''}}" data-mode="bus" bindtap="pick">
      <view class="h2 serif">公交</view>
      <view class="body">{{spot.transport.bus}}</view>
    </view>
    <view class="card {{mode === 'drive' ? 'on' : ''}}" data-mode="drive" bindtap="pick">
      <view class="h2 serif">自驾</view>
      <view class="body">{{spot.transport.drive}}</view>
    </view>
    <view class="card {{mode === 'walk' ? 'on' : ''}}" data-mode="walk" bindtap="pick">
      <view class="h2 serif">步行</view>
      <view class="body">{{spot.transport.walk}}</view>
    </view>
  </view>

  <view class="status">
    <text class="meta">{{spot.activityToday ? '今天有' : '今天无'}}</text>
    <text class="body">{{spot.nextActivity}}</text>
  </view>
  <view class="meta">开放：{{spot.open}}</view>

  <button class="outline nav" bindtap="openMap">打开导航</button>
</view>
