.page { height: 100vh; }
.map { width: 100%; height: 100vh; }
.mask, .drawer, .handle { }
.mask {
  position: fixed; inset: 0; background: rgba(31,35,41,0.16);
  opacity: 0; pointer-events: none; z-index: 2;
  transition: opacity 400ms cubic-bezier(0.2, 0.8, 0.2, 1);
}
.mask.show { opacity: 1; pointer-events: auto; }
.drawer {
  position: fixed; left: 0; right: 0; bottom: 0; height: 280px;
  background: #f4f1ec; border-radius: 12px 12px 0 0;
  box-shadow: 0 8px 24px rgba(31, 35, 41, 0.06);
  transform: translateY(105%); z-index: 3;
  transition: transform 400ms cubic-bezier(0.2, 0.8, 0.2, 1);
}
.drawer.show { transform: translateY(0); }
.handle { width: 32px; height: 3px; background: rgba(44,95,93,0.28); border-radius: 2px; margin: 10px auto; }
.row { display: flex; justify-content: space-between; margin-top: 16px; }
.reduce .drawer, .reduce .mask { transition: none; }
